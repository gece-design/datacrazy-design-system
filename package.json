{
  "name": "datacrazy-design-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "registry": "node scripts/gerar-registry.mjs",
    "predev": "npm run registry",
    "dev": "next dev -p 4321",
    "prebuild": "npm run registry",
    "build": "next build",
    "start": "next start -p 4321",
    "typecheck": "tsc --noEmit",
    "check:temas": "node scripts/check-temas.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:rotas": "node scripts/check-rotas.mjs",
    "check:doc-codigo": "node scripts/check-doc-codigo.mjs",
    "check:docs": "node .kfe-kit/scripts/kfe-docs.mjs audit",
    "check:paginas": "node scripts/verificar-paginas.mjs",
    "check:exemplos": "node scripts/check-exemplos.mjs",
    "check:regressao": "node scripts/regressao-visual.mjs check",
    "check:sidebar": "node scripts/medir-sidebar.mjs claro && node scripts/medir-sidebar.mjs escuro",
    "check": "npm run typecheck && npm run check:temas && npm run check:tokens && npm run check:rotas && npm run check:doc-codigo && npm run check:docs",
    "check:completo": "npm run check && npm run check:paginas && npm run check:exemplos && npm run check:regressao -- test-results/regressao/base",
    "docs:index": "node .kfe-kit/scripts/kfe-docs.mjs index",
    "consistencia": "node scripts/consistencia.mjs"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/react": "^2.1.7",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.3.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
